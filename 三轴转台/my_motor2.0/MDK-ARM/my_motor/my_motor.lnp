--cpu Cortex-M3
"my_motor\startup_stm32f103xe.o"
"my_motor\mpu6050.o"
"my_motor\main.o"
"my_motor\gpio.o"
"my_motor\can.o"
"my_motor\i2c.o"
"my_motor\tim.o"
"my_motor\usart.o"
"my_motor\stm32f1xx_it.o"
"my_motor\stm32f1xx_hal_msp.o"
"my_motor\stm32f1xx_hal_gpio_ex.o"
"my_motor\stm32f1xx_hal_can.o"
"my_motor\stm32f1xx_hal.o"
"my_motor\stm32f1xx_hal_rcc.o"
"my_motor\stm32f1xx_hal_rcc_ex.o"
"my_motor\stm32f1xx_hal_gpio.o"
"my_motor\stm32f1xx_hal_dma.o"
"my_motor\stm32f1xx_hal_cortex.o"
"my_motor\stm32f1xx_hal_pwr.o"
"my_motor\stm32f1xx_hal_flash.o"
"my_motor\stm32f1xx_hal_flash_ex.o"
"my_motor\stm32f1xx_hal_exti.o"
"my_motor\stm32f1xx_hal_i2c.o"
"my_motor\stm32f1xx_hal_tim.o"
"my_motor\stm32f1xx_hal_tim_ex.o"
"my_motor\stm32f1xx_hal_uart.o"
"my_motor\system_stm32f1xx.o"
--library_type=microlib --strict --scatter "my_motor\my_motor.sct"
--summary_stderr --info summarysizes --map --load_addr_map_info --xref --callgraph --symbols
--info sizes --info totals --info unused --info veneers
--list "my_motor.map" -o my_motor\my_motor.axf