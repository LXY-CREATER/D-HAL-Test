--cpu Cortex-M3
"led_tste\startup_stm32f103xe.o"
"led_tste\main.o"
"led_tste\gpio.o"
"led_tste\tim.o"
"led_tste\stm32f1xx_it.o"
"led_tste\stm32f1xx_hal_msp.o"
"led_tste\stm32f1xx_hal_gpio_ex.o"
"led_tste\stm32f1xx_hal_tim.o"
"led_tste\stm32f1xx_hal_tim_ex.o"
"led_tste\stm32f1xx_hal.o"
"led_tste\stm32f1xx_hal_rcc.o"
"led_tste\stm32f1xx_hal_rcc_ex.o"
"led_tste\stm32f1xx_hal_gpio.o"
"led_tste\stm32f1xx_hal_dma.o"
"led_tste\stm32f1xx_hal_cortex.o"
"led_tste\stm32f1xx_hal_pwr.o"
"led_tste\stm32f1xx_hal_flash.o"
"led_tste\stm32f1xx_hal_flash_ex.o"
"led_tste\stm32f1xx_hal_exti.o"
"led_tste\system_stm32f1xx.o"
--strict --scatter "LED_TSTE\LED_TSTE.sct"
--summary_stderr --info summarysizes --map --load_addr_map_info --xref --callgraph --symbols
--info sizes --info totals --info unused --info veneers
--list "LED_TSTE.map" -o LED_TSTE\LED_TSTE.axf