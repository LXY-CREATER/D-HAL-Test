--cpu Cortex-M3
"keytest\startup_stm32f103xe.o"
"keytest\main.o"
"keytest\gpio.o"
"keytest\adc.o"
"keytest\usart.o"
"keytest\stm32f1xx_it.o"
"keytest\stm32f1xx_hal_msp.o"
"keytest\stm32f1xx_hal_gpio_ex.o"
"keytest\stm32f1xx_hal_adc.o"
"keytest\stm32f1xx_hal_adc_ex.o"
"keytest\stm32f1xx_hal.o"
"keytest\stm32f1xx_hal_rcc.o"
"keytest\stm32f1xx_hal_rcc_ex.o"
"keytest\stm32f1xx_hal_gpio.o"
"keytest\stm32f1xx_hal_dma.o"
"keytest\stm32f1xx_hal_cortex.o"
"keytest\stm32f1xx_hal_pwr.o"
"keytest\stm32f1xx_hal_flash.o"
"keytest\stm32f1xx_hal_flash_ex.o"
"keytest\stm32f1xx_hal_exti.o"
"keytest\stm32f1xx_hal_tim.o"
"keytest\stm32f1xx_hal_tim_ex.o"
"keytest\stm32f1xx_hal_uart.o"
"keytest\system_stm32f1xx.o"
--strict --scatter "keytest\keytest.sct"
--summary_stderr --info summarysizes --map --load_addr_map_info --xref --callgraph --symbols
--info sizes --info totals --info unused --info veneers
--list "keytest.map" -o keytest\keytest.axf