--cpu Cortex-M3
"tim_inputcapture\startup_stm32f103xe.o"
"tim_inputcapture\main.o"
"tim_inputcapture\gpio.o"
"tim_inputcapture\tim.o"
"tim_inputcapture\usart.o"
"tim_inputcapture\stm32f1xx_it.o"
"tim_inputcapture\stm32f1xx_hal_msp.o"
"tim_inputcapture\stm32f1xx_hal_gpio_ex.o"
"tim_inputcapture\stm32f1xx_hal_tim.o"
"tim_inputcapture\stm32f1xx_hal_tim_ex.o"
"tim_inputcapture\stm32f1xx_hal.o"
"tim_inputcapture\stm32f1xx_hal_rcc.o"
"tim_inputcapture\stm32f1xx_hal_rcc_ex.o"
"tim_inputcapture\stm32f1xx_hal_gpio.o"
"tim_inputcapture\stm32f1xx_hal_dma.o"
"tim_inputcapture\stm32f1xx_hal_cortex.o"
"tim_inputcapture\stm32f1xx_hal_pwr.o"
